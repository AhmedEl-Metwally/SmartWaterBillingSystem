@page "/Register"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@* @rendermode InteractiveWebAssembly *@

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-12">
    <EditForm EditContext="@_editContext" OnValidSubmit="OnValidSubmit">
        <DataAnnotationsValidator />

        <MudGrid Justify="Justify.Center" Spacing="4">
            <MudItem xs="12" md="8" lg="7">
                <div style="background: #ffffff; border-radius: 24px; border: 1px solid #e0e0e0; box-shadow: 0 10px 30px rgba(0,0,0,0.04); padding: 40px;">
                    @if (!string.IsNullOrEmpty(_serverError))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="rounded-lg mb-6">@_serverError</MudAlert>
                    }

                    <div class="text-center mb-8">
                        <MudText Typo="Typo.h4" Style="font-weight: 800; color: #1A237E; letter-spacing: -0.5px;">Create a new account</MudText>
                        <MudText Typo="Typo.body2" Class="mt-2" Style="color: #757575; font-size: 0.95rem;">Join the Smart Water Billing System</MudText>
                    </div>

                    <MudGrid Spacing="3">
                        <MudItem xs="12">
                            <MudTextField Label="Please enter Name" Variant="Variant.Outlined" @bind-Value="_registerAccount.Username" For="@(() => _registerAccount.Username)"
                                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person" AdornmentColor="Color.Primary" />
                        </MudItem>

                        <AuthBaseForm AuthBaseForms="_registerAccount.AuthBaseForms" />


                        <MudItem xs="12">
                            <MudTextField Label="Please enter Confirm password" Variant="Variant.Outlined" InputType="InputType.Password" @bind-Value="_registerAccount.ConfirmPassword" For="@(() => _registerAccount.ConfirmPassword)"
                                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.LockClock" AdornmentColor="Color.Primary" />
                        </MudItem>
                    </MudGrid>

                    <div class="d-flex justify-space-between align-center mt-8">
                        <MudButton Link="/Login" Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Login" Style="text-transform: none; font-weight: 600;">Log in</MudButton>
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@_processing" Size="Size.Large" Style="border-radius: 12px; min-width: 180px; text-transform: none; font-weight: 600; box-shadow: 0 4px 12px rgba(26, 35, 126, 0.2);">
                            @if (_processing)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" Color="Color.Inherit" />
                                <span>Registration ....</span>
                            }
                            else
                            {
                                <span>Create Account</span>
                            }
                        </MudButton>
                    </div>
                </div>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudContainer>