@page "/Subscribers"
@attribute [Authorize]
@rendermode InteractiveWebAssembly

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <MudCard Elevation="4" Style="border-radius: 16px; overflow: hidden;">
        <MudCardContent Class="pa-0">
            <MudDataGrid Items="@_subscribers" T="SubscriberClientDto" Bordered="false" Striped="true" Hover="true" PageSize="10" Class="pa-0">
                <ToolBarContent>
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" Size="Size.Large" />
                        <MudText Typo="Typo.h5" Style="font-weight: 800; color: #1A237E;"> Subscribers </MudText>
                    </div>
                    <MudSpacer />
                    <GetSubscriberById OnSubscriberFound="HandleSubscriberFound" />
                    <div class="ms-3">
                        <CreateSubscriber OnSubscriberCreated="HandleSubscriberCreated" />
                    </div>
                </ToolBarContent>
                <Columns>
                    <PropertyColumn Property="S => S.PersonalIDNumber" Title="Personal ID" HeaderStyle="font-weight: 800; color: #1A237E;" CellStyle="font-weight: 600;" />
                    <PropertyColumn Property="S => S.SubscriberName" Title="Name" HeaderStyle="font-weight: 800; color: #1A237E;" CellStyle="font-weight: 600;" />
                    <PropertyColumn Property="S => S.SubscriberPhoneNumber" Title="Phone Number" HeaderStyle="font-weight: 800; color: #1A237E;" CellStyle="font-weight: 600;" />
                    <PropertyColumn Property="S => S.SubscriberArea" Title="Area" HeaderStyle="font-weight: 800; color: #1A237E;" CellStyle="font-weight: 600;" />
                    <TemplateColumn Title="Actions" HeaderClass="d-flex justify-center" CellStyle="text-align: center;">
                        <CellTemplate>
                            <DeleteSubscriber subscriberClientDto="context.Item" OnSubscriberDeleted="HandleSubscriberDeleted" />
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        </MudCardContent>
    </MudCard>
</MudContainer>